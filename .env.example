# -----------------------------------------------------------------------------
# VeilX Agent - Environment Configuration Template
# Copy this file to .env.local and configure your credentials
# -----------------------------------------------------------------------------

# Network Mode: "testnet" or "mainnet"
NEXT_PUBLIC_NEAR_NETWORK=testnet
NEXT_PUBLIC_DEFAULT_CHAIN=base-sepolia

# NEAR RPC Endpoints
# Testnet: https://test.rpc.fastnear.com, https://rpc.testnet.near.org
# Mainnet: https://rpc.mainnet.near.org, https://1rpc.io/near
NEXT_PUBLIC_NEAR_RPC_URL=https://test.rpc.fastnear.com

# NEAR Chain Signatures MPC Signer Contract
# Testnet: v1.signer-prod.testnet
# Mainnet: v1.signer
NEXT_PUBLIC_MPC_CONTRACT_ID=v1.signer-prod.testnet

# Defuse 1Click Solver API
NEXT_PUBLIC_1CLICK_API_URL=https://1click.defuse.org
# Optional Bearer token for advanced TEE confidential quoting
ONECLICK_AUTH_TOKEN=

# Autonomous Agent Spending Guardrails (USD)
NEXT_PUBLIC_DEFAULT_SPEND_LIMIT_USD=150
NEXT_PUBLIC_PER_TX_QUARANTINE_THRESHOLD_USD=25
NEXT_PUBLIC_WEEKLY_SPEND_CAP_USD=500

# NEAR Relayer Account (for gasless subaccount creation & faucet)
# Testnet: veilx-relayer.testnet
# Mainnet: veilx-relayer.near
NEAR_RELAYER_ACCOUNT_ID=veilxapp.veilx-agent.testnet
NEAR_RELAYER_PRIVATE_KEY=ed25519:YOUR_NEAR_RELAYER_PRIVATE_KEY_HERE

# Database / Supabase Storage (for persistent transactions & audit trail)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key_here
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here

# Social Authentication (Twitter / X API v2)
TWITTER_CLIENT_ID=your_twitter_client_id_here
TWITTER_CLIENT_SECRET=your_twitter_client_secret_here
NEXTAUTH_SECRET=your_nextauth_secret_32_characters_minimum
NEXTAUTH_URL=http://localhost:3000

# Optional: Privy Multi-Auth (Email, Google, Passkey)
NEXT_PUBLIC_PRIVY_APP_ID=
PRIVY_APP_SECRET=
